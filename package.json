{
  "name": "react-native-debug-toolkit",
  "version": "4.1.2",
  "description": "React Native debugging toolkit with an in-app HTTP inspector, console logs, a local Web Console, and runtime diagnostics for AI coding assistants",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./adapters/zustand": {
      "types": "./lib/typescript/src/adapters/zustand.d.ts",
      "react-native": "./src/adapters/zustand.ts",
      "import": "./lib/module/adapters/zustand.js",
      "require": "./lib/commonjs/adapters/zustand.js",
      "default": "./lib/commonjs/adapters/zustand.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "node",
    "ios",
    "android",
    "react-native-debug-toolkit.podspec",
    "README.md",
    "README-zh-CN.md",
    "docs/integration*.md",
    "docs/configuration*.md",
    "docs/examples/integration",
    "docs/setup*.md",
    "docs/usage*.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.gradle/**",
    "!android/build/**",
    "!android/.cxx/**"
  ],
  "scripts": {
    "hub": "node bin/debug-toolkit.js hub dev",
    "demo:ios": "npm --prefix Demo run ios",
    "demo:android": "npm --prefix Demo run android",
    "ai:init": "node bin/debug-toolkit.js init",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p type-tests/tsconfig.json",
    "typecheck:docs": "tsc -p docs/examples/integration/tsconfig.json",
    "check:docs": "node scripts/check-doc-config.mjs && node --test scripts/__tests__/check-doc-config.test.mjs",
    "typescript": "npm run typecheck",
    "test": "jest",
    "test:package": "node --test scripts/__tests__/verify-package.test.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "eval:runtime-skill": "node node/hub/evals/runtime-diagnostics/run.js --model gpt-5.5 --reasoning high --runs 5",
    "build": "bob build",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\" \"node/**/*.js\" \"bin/**/*.js\"",
    "prepare": "bob build",
    "demo:api": "npm --prefix Demo run demo:api"
  },
  "bin": {
    "debug-toolkit": "bin/debug-toolkit.js"
  },
  "keywords": [
    "react-native",
    "react-native-debugging",
    "debugging",
    "developer-tools",
    "network-inspector",
    "http-inspector",
    "console-logs",
    "runtime-logs",
    "state-debugging",
    "zustand",
    "react-navigation",
    "ai-debugging",
    "cli",
    "web-console"
  ],
  "author": "zcj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/superzcj/react-native-debug-toolkit"
  },
  "homepage": "https://github.com/superzcj/react-native-debug-toolkit#readme",
  "bugs": {
    "url": "https://github.com/superzcj/react-native-debug-toolkit/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@react-native-clipboard/clipboard": ">=1.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.76.6 <=0.85.1",
    "react-native-nitro-modules": "0.35.10"
  },
  "peerDependenciesMeta": {
    "@react-native-clipboard/clipboard": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.76.0",
    "@react-native/eslint-config": "^0.76.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.1",
    "eslint": "^8.57.0",
    "jest": "^30.3.0",
    "prettier": "^3.3.0",
    "react": "^18.3.1",
    "react-native": "^0.76.6",
    "react-native-builder-bob": "^0.30.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.5.0"
  },
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "react-native-mmkv": "4.3.2"
  }
}
